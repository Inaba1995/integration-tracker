// Трекер интеграции — схема данных.
// Провайдер: sqlite для локального запуска. Готовность к PostgreSQL:
// см. prisma/postgres/schema.prisma (та же модель, провайдер postgresql).
// Статусы/типы хранятся как строки: единая схема для SQLite и PostgreSQL,
// валидация значений — на уровне домена и zod-схем интерфейса.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         String      @default("VIEWER") // ADMIN | INTEGRATOR | VIEWER
  createdAt    DateTime    @default(now())
  tasks        IntegrationTask[]
  auditLogs    AuditLog[]
}

model Feature {
  id                 String          @id @default(cuid())
  code               String          @unique
  title              String
  description        String          @default("")
  status             String          @default("PLANNED") // PLANNED | IN_PROGRESS | BLOCKED | DONE
  implementationType String          @default("TBD") // STANDARD_API | EXTENSION | CUSTOM_HTTP_SERVICE | TBD
  priority           String          @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  estimateDays       Float?
  estimateCost       Float? // в рублях
  notes              String          @default("")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tasks              IntegrationTask[]
  estimates          Estimate[]
}

model IntegrationTask {
  id          String    @id @default(cuid())
  featureId   String
  feature     Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  title       String
  status      String    @default("TODO") // TODO | IN_PROGRESS | BLOCKED | DONE
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([featureId])
  @@index([status])
}

model ApiEndpoint {
  id             String   @id @default(cuid())
  name           String
  method         String // GET | POST | PATCH | PUT | DELETE
  path           String
  direction      String // INBOUND | OUTBOUND
  payloadSchema  String   @default("{}") // JSON-описание схемы
  responseSchema String   @default("{}") // JSON-описание схемы
  status         String   @default("DRAFT") // DRAFT | MOCKED | LIVE | FAILING
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WebhookEvent {
  id             String   @id @default(cuid())
  source         String // 1C | ai-assistant | system
  eventType      String // lead.created | booking.confirmed | schedule.updated ...
  payloadJson    String
  receivedAt     DateTime @default(now())
  status         String   @default("RECEIVED") // RECEIVED | PROCESSED | DUPLICATE | FAILED
  // Ключ хранится с индексом (не unique): повтор создаёт запись-лог
  // со статусом DUPLICATE, но бизнес-сущности (Lead/Booking) не дублируются.
  idempotencyKey String
  correlationId  String?
  processedAt    DateTime?

  @@index([idempotencyKey])
}

model Client {
  id         String    @id @default(cuid())
  externalId String?   @unique // ID клиента в 1С
  fullName   String
  phone      String
  email      String    @default("")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  leads      Lead[]
  bookings   Booking[]
}

model Lead {
  id             String   @id @default(cuid())
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  source         String // VK | TELEGRAM | WHATSAPP | MAX | EMAIL | WEB | OTHER
  payloadJson    String
  status         String   @default("NEW") // NEW | SENT_TO_1C | DUPLICATE | ERROR
  idempotencyKey String   @unique
  externalId     String? // ID заявки в 1С
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Service {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  direction String  @default("") // направление/категория
  price     Float?
  active    Boolean @default(true)
}

model Specialist {
  id       String  @id @default(cuid())
  code     String  @unique
  fullName String
  phone    String  @default("")
  active   Boolean @default(true)
}

model ScheduleSlot {
  id            String    @id @default(cuid())
  serviceId     String // code услуги в 1С
  specialistId  String // code специалиста в 1С
  startAt       DateTime
  endAt         DateTime
  capacity      Int       @default(1)
  bookedCount   Int       @default(0)
  syncedAt      DateTime  @default(now())
  bookings      Booking[]

  @@unique([serviceId, specialistId, startAt])
  @@index([startAt])
}

model Booking {
  id             String        @id @default(cuid())
  externalId     String?       @unique // ID записи в 1С
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId      String
  specialistId   String
  scheduleSlotId String?
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  slotStart      DateTime
  slotEnd        DateTime
  status         String        @default("PENDING") // PENDING | CONFIRMED | CANCELLED | RESCHEDULED
  idempotencyKey String        @unique
  errorCode      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

model ScheduleSyncLog {
  id         String   @id @default(cuid())
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  slotCount  Int      @default(0)
  status     String   @default("RUNNING") // RUNNING | OK | FAILED
  message    String   @default("")
}

model ErrorLog {
  id           String    @id @default(cuid())
  context      String // webhook | booking | lead | schedule | sync
  errorCode    String // внутренний код (NO_SEATS, ONEC_UNAVAILABLE, ...)
  rawCode      String    @default("") // оригинальный код 1С
  message      String
  payloadJson  String    @default("{}")
  retryCount   Int       @default(0)
  status       String    @default("PENDING") // PENDING | RETRYING | FAILED | RESOLVED
  correlationId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

model Estimate {
  id        String   @id @default(cuid())
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  hours     Float
  cost      Float
  currency  String   @default("RUB")
  comment   String   @default("")
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  model         String // Feature | Booking | Lead | ScheduleSlot | ...
  recordId      String
  action        String // CREATE | UPDATE | DELETE | SYNC | CANCEL | RESCHEDULE
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail    String   @default("system")
  dataJson      String   @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([model, recordId])
}
