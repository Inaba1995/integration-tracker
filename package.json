{
  "name": "integration-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Трекер интеграции ИИ-ассистента с 1С:Фитнес клуб (студия пилатеса)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,green \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/interface/server.ts",
    "dev:ui": "npm --prefix ui run dev",
    "build": "npm run build:ui && npm run build:api && npm run build:seed",
    "build:api": "tsup src/interface/server.ts --format esm --out-dir dist --sourcemap",
    "build:seed": "tsup prisma/seed.ts --format esm --out-dir dist --sourcemap",
    "build:ui": "npm --prefix ui run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && npm --prefix ui run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:pg": "prisma db push --schema prisma/postgres/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "openapi": "tsx src/interface/openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "pino": "^9.6.0",
    "prisma": "^6.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
