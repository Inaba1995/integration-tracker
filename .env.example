# --- Общее ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- База данных (SQLite по умолчанию; для PostgreSQL см. README) ---
DATABASE_URL="file:./dev.db"

# --- 1С-адаптер: mock (по умолчанию) | real ---
ONEC_MODE=mock
# Реальный режим (только по флагу ONEC_MODE=real), секреты только в env:
ONEC_BASE_URL=
ONEC_TOKEN=
ONEC_TIMEOUT_MS=5000

# --- Безопасность ---
JWT_SECRET=change-me-in-production
WEBHOOK_SECRET=change-me-webhook-secret
CORS_ORIGIN=http://localhost:5173
